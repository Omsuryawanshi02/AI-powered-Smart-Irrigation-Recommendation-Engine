# Copy to .env and adjust as needed. All values have sensible defaults.

# Database connection string (SQLite by default)
DATABASE_URL=sqlite:///./irrigation.db

# Path to the trained ML model package
MODEL_PATH=models/irrigation_model_package.pkl

# Weather API (Open-Meteo, no key required)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT=6

# Comma-separated allowed origins for CORS, or "*" for all
CORS_ORIGINS=*

# Baseline (traditional fixed-schedule) irrigation assumptions, used for water-savings analytics
BASELINE_IRRIGATION_MM=25
BASELINE_INTERVAL_DAYS=3
